{
  "name": "dsh-browser-plugin",
  "version": "0.9.0",
  "private": true,
  "description": "DSH 浏览器插件：右侧边栏里的浏览器标签页，每个会话一只 Chrome、各自一份独立 profile。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "puppeteer-core": "^25.8.0"
  },
  "scripts": {
    "build": "node --no-warnings scripts/build-host.mjs && node --no-warnings scripts/build-client.mjs",
    "build:host": "node --no-warnings scripts/build-host.mjs",
    "build:client": "node --no-warnings scripts/build-client.mjs",
    "link-deps": "node scripts/link-deps.mjs",
    "test": "node --no-warnings test/run.mjs"
  }
}
